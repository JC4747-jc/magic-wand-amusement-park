     internal static class RoomWindowLandscape
     {
+        // Shallow photographic relief. Both the landing particles and the image
+        // surface use the same coordinates as the camera moves past the wall.
+        internal static Vector3 LakePoint(float u,float v)
+        {
+            float distance=Mathf.SmoothStep(0,1,Mathf.InverseLerp(.04f,.56f,v));
+            return new Vector3((u-.5f)*.32f,v*.516f,.006f+.023f*distance);
+        }
+
+        internal static Mesh CreateLakeMesh()
+        {
+            const int rows=32;
+            var vertices=new Vector3[2*(rows+1)];
+            var uv=new Vector2[vertices.Length];
+            var indices=new int[rows*6];
+            for(int row=0;row<=rows;row++){
+                int i=row*2;
+                float v=(float)row/rows;
+                vertices[i]=LakePoint(0,v); vertices[i+1]=LakePoint(1,v);
+                uv[i]=new Vector2(0,v); uv[i+1]=new Vector2(1,v);
+                if(row==rows)break;
+                int t=row*6;
+                indices[t]=i; indices[t+1]=i+2; indices[t+2]=i+1;
+                indices[t+3]=i+1; indices[t+4]=i+2; indices[t+5]=i+3;
+            }
+            var mesh=new Mesh{name="Swan lake photographic relief",vertices=vertices,uv=uv,triangles=indices};
+            mesh.RecalculateBounds();
+            return mesh;
+        }
