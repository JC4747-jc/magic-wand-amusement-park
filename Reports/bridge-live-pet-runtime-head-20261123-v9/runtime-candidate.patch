diff --git a/Tools/check_pet_head_live_service.py b/Tools/check_pet_head_live_service.py
new file mode 100644
index 0000000..aed2529
--- /dev/null
+++ b/Tools/check_pet_head_live_service.py
@@ -0,0 +1,138 @@
+"""Loopback-only probe over the unmodified PICF YOLO service and real Unity JPEGs."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import socket
+import struct
+import sys
+import threading
+import time
+from argparse import Namespace
+
+import cv2
+import numpy as np
+
+from check_pet_head_ap10k import MODEL, head_pixels, read, sha
+from check_pet_head_body_window import inputs, two_eye_local
+from check_pet_head_camera_inputs import pxr_luminance
+
+
+SCHEDULE = (32,32,33,34,35,35,32,33,34,35,150)
+STAGE = Path('D:/MagicMRSourceCandidate/mr-jc-pet-metric-review-20261123')
+
+
+def contained_dog_crop(small, large):
+    if small['class'] != 'dog' or large['class'] != 'dog' or min(small['confidence'],large['confidence']) < .5:
+        return False
+    sw,sh = small['x2']-small['x1'],small['y2']-small['y1']
+    lw,lh = large['x2']-large['x1'],large['y2']-large['y1']
+    if not 0 < sw <= lw*1.02 or not 0 < sh <= lh*.85:
+        return False
+    ix = max(0,min(small['x2'],large['x2'])-max(small['x1'],large['x1']))
+    iy = max(0,min(small['y2'],large['y2'])-max(small['y1'],large['y1']))
+    return .95 <= sw/lw and ix*iy >= .98*sw*sh and abs(small['y1']-large['y1']) <= .03*lh
+
+
+def main():
+    sys.path.insert(0,str(STAGE))
+    import tcp_server as server
+    import torch
+    from scene_protocol import SCENES
+
+    torch.set_num_threads(1)
+    cv2.setNumThreads(2)
+    runtime = os.environ.get('PET_HEAD_REVIEW_RUNTIME') == '1'
+    if runtime and os.environ.get('PET_HEAD_SEPARATE_PROCESS')!='1':
+        from serve_pet_stereo_head_candidate import main as serve_head
+        threading.Thread(target=serve_head,args=(Namespace(detector_root=STAGE,host='127.0.0.1',port=15006,
+                                                               editor_check=True,delay_frame=8),),daemon=True).start()
+    model = MODEL/'end2end.onnx'
+    assert sha(model)==read(MODEL/'model-source.json')['onnxSha256']
+    assert sha(STAGE/'yolov8n.pt')=='f59b3d833e2ff32e194b5bb8e08d211dc7c5bdf144b90d2c8412c47ccfc83b36'
+    net = None if runtime else cv2.dnn.readNetFromONNX(str(model))
+    is_cat=os.environ.get('PET_HEAD_REVIEW_CAT')=='1'
+    schedule=(30,30,31,32,30,31,32,32,30,31,32,249) if runtime else (30,30,31,32,32,30,31,32,249) if is_cat else SCHEDULE
+    delay_index=4 if is_cat else 5
+    species='Cat' if is_cat else 'Dog'
+    if is_cat:
+        assert sha(STAGE/'yolo11s.pt')=='85a76fe86dd8afe384648546b56a7a78580c7cb7b404fc595f97969322d502d5'
+        server.PROFILE_CONFIG=STAGE/'pet-metric-profiles.json'
+    iou = float(os.environ.get('PET_HEAD_REVIEW_IOU',server.DEFAULT_IOU))
+    assert iou in (server.DEFAULT_IOU,.65)
+    merge_contained = os.environ.get('PET_HEAD_REVIEW_CONTAINED') == '1'
+    original = server.detections_from_result
+    if merge_contained:
+        def collapse_diagnostic_crops(result):
+            detections = original(result)
+            return [d for d in detections if not any(contained_dog_crop(d,other) for other in detections)]
+        server.detections_from_result = collapse_diagnostic_crops
+    requested_device=os.environ.get('PET_HEAD_REVIEW_DETECTOR_DEVICE','cpu') if runtime else 'cpu'
+    device=server.resolve_device(requested_device)
+    config = server.InferenceConfig(requested_device,False,640,server.DEFAULT_CONF,iou,8)
+    frames = {}
+    for row in inputs():
+        group='metricCat:localCanary:' if is_cat else 'metricDog:'
+        if row['key'].startswith(group) and row['sourceFrame'] in schedule:
+            image,right = [cv2.imread(str(path.with_suffix('.png'))) for path in row['files']]
+            thumb = cv2.resize(image,(80,60),interpolation=cv2.INTER_AREA).astype(np.int16)
+            gray = [pxr_luminance(frame) for frame in (image,right)]
+            frames[row['sourceFrame']] = row,thumb,gray
+    assert set(frames)==set(schedule)
+
+    with socket.socket() as listener:
+        listener.bind(('127.0.0.1',15005))
+        listener.listen(1)
+        listener.settimeout(100)
+        print(f'READY 15005 IoU={iou} contained={merge_contained} device={device}',flush=True)
+        client,_ = listener.accept()
+        direct,peer = socket.socketpair()
+        worker = threading.Thread(target=server.serve_client,args=(peer,None,device,config,True),daemon=True)
+        worker.start()
+        with client,direct,direct.makefile('rb') as stream:
+            client.settimeout(25)
+            direct.settimeout(18)
+            for index,source in enumerate(schedule):
+                frame,timestamp,w,h,jpeg,scene=server.read_pico_frame(client,include_scene=True)
+                started=time.perf_counter()
+                assert (frame,w,h,scene)==(index+1,640,480,'pet')
+                image = cv2.imdecode(np.frombuffer(jpeg,dtype=np.uint8),cv2.IMREAD_COLOR)
+                thumb = cv2.resize(image,(80,60),interpolation=cv2.INTER_AREA).astype(np.int16)
+                scores = {n:float(np.mean(np.abs(thumb-data[1]))) for n,data in frames.items()}
+                assert min(scores,key=scores.get)==source and scores[source]<5,scores
+                direct.sendall(b'PICF'+bytes((2,SCENES.index(scene)))+struct.pack('<IqIII',frame,timestamp,w,h,len(jpeg))+jpeg)
+                reply=json.loads(stream.readline(32769))
+                assert (reply['frame_id'],reply['timestamp'],reply['scene'],reply['status'])==(frame,timestamp,'pet','OK')
+                if runtime:
+                    client.sendall((json.dumps(reply,separators=(',',':'))+'\n').encode())
+                    print(json.dumps(dict(frame=frame,source=source,pcMs=(time.perf_counter()-started)*1000,
+                                          jpegSha256=hashlib.sha256(jpeg).hexdigest(),sourceThumbDistance=scores[source])),flush=True)
+                    continue
+                hits=[d for d in reply['detections'] if d['class_name']==species and d['confidence']>=.5]
+                candidate=dict(frame_id=frame,timestamp=timestamp,source_frame=source,verified=False)
+                row,_,gray=frames[source]
+                if len(hits)==1:
+                    hit=hits[0]
+                    box=np.array([hit[k] for k in ('x1','y1','x2','y2')])
+                    disparity=row['scale']/row['bodyM']
+                    right_color=cv2.cvtColor(gray[1],cv2.COLOR_GRAY2BGR)
+                    left=head_pixels(net,image,box)
+                    right=head_pixels(net,right_color,box-[disparity,0,disparity,0])
+                    semantic,matches,pose_d=two_eye_local(row,left,right,images=gray)
+                    if semantic and ('nose' in matches or len(matches)>=2):
+                        x,y=left['nose']['xy']
+                        d=round(x)-matches['nose'][0] if 'nose' in matches else pose_d
+                        candidate.update(instance_id=hit['instance_id'],verified=True,x=x,y=y,depth=row['scale']/d)
+                candidate['pc_ms']=(time.perf_counter()-started)*1000
+                if index==delay_index:
+                    time.sleep(.33)
+                reply['head_probe']=candidate
+                client.sendall((json.dumps(reply,separators=(',',':'))+'\n').encode())
+                print(json.dumps(dict(candidate=candidate,jpegSha256=hashlib.sha256(jpeg).hexdigest(),
+                                      sourceThumbDistance=scores[source],injectedDelay=index==delay_index)),flush=True)
+        worker.join(5)
+        assert not worker.is_alive(), 'YOLO service failed to leave its fixture connection'
+
+
+if __name__=='__main__':
+    main()
