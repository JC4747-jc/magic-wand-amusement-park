index 0000000..68aa00a
--- /dev/null
+++ b/Assets/Editor/PetLiveRecognitionAutomaticHead.cs
@@ -0,0 +1,230 @@
+using System;
+using System.Linq;
+using System.Reflection;
+using MagicMR;
+using Perception;
+using UnityEngine;
+
+public static partial class PetLiveRecognitionChecks
+{
+    static int probeIndex, headContinuity, confirmedBeforeDelay, confirmedAfterDelay;
+    static float probeLastAccepted = -1f;
+    static Transform probeAnchor;
+    static string probeIdentity;
+    static float waitForRuntimeUntil;
+    static int resumeAt;
+    static string runtimeStatus;
+    static readonly MethodInfo PollHead = typeof(ParkStereoReceiver).GetMethod("PollHeadSession",BindingFlags.Instance|BindingFlags.NonPublic);
+    static readonly MethodInfo RememberHead = typeof(ParkStereoReceiver).GetMethod("RememberHeadImage",BindingFlags.Instance|BindingFlags.NonPublic);
+    static readonly PropertyInfo HeadStatus = typeof(ParkStereoReceiver).GetProperty("PetHeadStatus");
+
+    static void RememberRuntimeImage(Texture2D image)
+    {
+        Color32[] pixels = image.GetPixels32();
+        var rgba = new byte[pixels.Length*4];
+        for (int i=0, j=0; i<pixels.Length; i++, j+=4)
+        {
+            rgba[j]=pixels[i].r; rgba[j+1]=pixels[i].g; rgba[j+2]=pixels[i].b; rgba[j+3]=pixels[i].a;
+        }
+        RememberHead.Invoke(receiver,new object[]{rgba});
+    }
+
+    static ParkActor RuntimeActor(string id) => UnityEngine.Object.FindObjectsByType<ParkActor>(
+        FindObjectsInactive.Include,FindObjectsSortMode.None).SingleOrDefault(a => a.instanceId==id);
+
+    static void StepRuntimeHead()
+    {
+        PollHead.Invoke(receiver,null);
+        string status=(string)HeadStatus.GetValue(receiver);
+        if (runtimeStatus!=status)
+        {
+            runtimeStatus=status;
+            trace.Add(runtimeStatus);
+        }
+        if (!withholdMetricFrames) return;
+        float now=Time.realtimeSinceStartup;
+        if (resumeAt == optics.probeDelayIndex+1)
+        {
+            if (now < waitForRuntimeUntil) return;
+            Require(metricActor && !metricActor.reliableHeadPose && !metricActor.headAnchor,"An unconfirmed or expired head remained attached.");
+            controller.ExpirePhysicalTargets();
+            CalibratedParkReplayChecks.Set(receiver,"headTracked",false);
+            PollHead.Invoke(receiver,null);
+            trace.Add("Expired before late sidecar result; cleared tracking, then restarted three-frame confirmation.");
+        }
+        else
+        {
+            if (!metricActor || !metricActor.reliableHeadPose || !metricActor.headAnchor)
+            {
+                Require(now < waitForRuntimeUntil,"Runtime head did not attach after three measured captures.");
+                return;
+            }
+            Require(metricActor.tracked && metricActor.headAnchor.position.z > 1.35f && metricActor.headAnchor.position.z < 1.65f,
+                "Runtime head was not projected through the captured camera pose at metric depth.");
+            trace.Add(FormattableString.Invariant($"Runtime head attached to {metricActor.instanceId} at {metricActor.headAnchor.position.z:F3} m; capture to anchor below {receiver.maxAge*1000:F0} ms."));
+        }
+        withholdMetricFrames=false;
+    }
+
+    static void ObserveRuntimeBody(DetectionFrameMessage packet, string raw)
+    {
+        var hit = packet.detections.Single(d=>d.class_name=="Cat" && d.confidence>=.5f);
+        if (!warm)
+        {
+            // Warm native matching JIT without observing a target or offering a head request.
+            StereoPatchMatcher.EstimateDepth(leftGray[0],rightGray[0],640,480,
+                Mathf.RoundToInt((hit.x1+hit.x2)*.5f),Mathf.RoundToInt((hit.y1+hit.y2)*.5f),
+                optics.intrinsics[0],optics.baseline,16,16);
+            warm=true;
+            probeIndex++;
+            return;
+        }
+        nextFrame=sentAt+.20f;
+        receiver.Receive(raw);
+        Require(receiver.Status.StartsWith("TRANSLATION_ONLY:",StringComparison.Ordinal),"Unusable runtime head body: "+receiver.Status);
+        trace.Add(FormattableString.Invariant($"Body PICF {packet.frame_id}, source {optics.sourceFrames[probeIndex]} {hit.instance_id}: {receiver.AcceptedResultAge*1000:F1} ms."));
+        if (probeIndex == optics.sourceFrames.Length-1)
+        {
+            var nextActor = RuntimeActor(hit.instance_id);
+            Require(metricActor && hit.instance_id != metricActor.instanceId && nextActor &&
+                    !metricActor.headAnchor && !metricActor.reliableHeadPose &&
+                    !nextActor.headAnchor && !nextActor.reliableHeadPose && errors==0,
+                "Runtime target switch was not isolated from previous head state.");
+            trace.Add("A new detector ID cleared the old head and received no head on its first observation.");
+            Finish(0,"PASS: saved BridgeStereoFusion attached runtime Pet head from capture-bound stereo and cleared it on timeout and ID change.");
+            return;
+        }
+        metricActor=RuntimeActor(hit.instance_id);
+        if (probeIndex==optics.probeDelayIndex-4)
+        {
+            Require(metricActor && metricActor.tracked &&
+                    controller.ProcessHandSample(MetricHand(Point,.02f,-Vector3.forward*.09f),true)==EditDimension.None &&
+                    controller.selected==metricActor, "Could not select a stable cat through the shared point-pinch input.");
+            CalibratedParkReplayChecks.Set(receiver,"petHeadPort",15006);
+            trace.Add($"Selected {metricActor.instanceId} through the shared desktop point-pinch input; enabled the head candidate.");
+        }
+        if (probeIndex==optics.probeDelayIndex-1 || probeIndex==optics.probeDelayIndex ||
+            probeIndex==optics.sourceFrames.Length-2)
+        {
+            withholdMetricFrames=true;
+            resumeAt=probeIndex+1;
+            waitForRuntimeUntil=sentAt+(probeIndex==optics.probeDelayIndex ? .50f : .30f);
+        }
+        probeIndex++;
+    }
+
+    [Serializable]
+    sealed class AutomaticHeadReply
+    {
+        public AutomaticHeadCandidate head_probe;
+    }
+
+    [Serializable]
+    sealed class AutomaticHeadCandidate
+    {
+        public int source_frame;
+        public long frame_id;
+        public long timestamp;
+        public string instance_id;
+        public bool verified;
+        public float x, y, depth, pc_ms;
+    }
+
+    static void ClearAutomaticHead()
+    {
+        headContinuity = 0;
+        probeLastAccepted = -1f;
+        if (metricActor)
+        {
+            metricActor.reliableHeadPose = false;
+            metricActor.headAnchor = null;
+        }
+        if (probeAnchor) UnityEngine.Object.Destroy(probeAnchor.gameObject);
+        probeAnchor = null;
+    }
+
+    static void StepAutomaticHead()
+    {
+        if (probeLastAccepted >= 0f && Time.realtimeSinceStartup - probeLastAccepted > receiver.maxAge)
+        {
+            ClearAutomaticHead();
+            trace.Add("Candidate head expired while the frame was in flight.");
+        }
+    }
+
+    static void ObserveAutomaticHead(DetectionFrameMessage packet, string raw)
+    {
+        var candidate = JsonUtility.FromJson<AutomaticHeadReply>(raw).head_probe;
+        Require(candidate != null && candidate.source_frame == optics.sourceFrames[probeIndex] &&
+                candidate.frame_id == packet.frame_id && candidate.timestamp == packet.timestamp,
+                "Candidate is not bound to the saved sender's frame and source image.");
+        if (!warm)
+        {
+            warm = true;
+            probeIndex++;
+            return;
+        }
+        nextFrame = sentAt + .10f;
+        receiver.Receive(raw);
+        float age = receiver.AcceptedResultAge;
+        trace.Add(FormattableString.Invariant($"PICF {packet.frame_id}, source {candidate.source_frame}: {age*1000:F1} ms, PC {candidate.pc_ms:F1} ms; head evidence {candidate.verified}; {receiver.Status}"));
+        bool bodyLocated = receiver.Status.StartsWith("TRANSLATION_ONLY:", StringComparison.Ordinal);
+        bool idMatches = packet.detections.Count(d => d.class_name == optics.probeSpecies && d.confidence >= .5f && d.instance_id == candidate.instance_id) == 1;
+        if (probeIndex == optics.probeDelayIndex)
+        {
+            Require(confirmedBeforeDelay > 0 && candidate.verified && age > receiver.maxAge && !bodyLocated,
+                "An injected delayed reply must have genuine head evidence but fail the spatial deadline.");
+            ClearAutomaticHead();
+            Require(!metricActor || (!metricActor.reliableHeadPose && !metricActor.headAnchor), "Expired head remained on the actor.");
+        }
+        else if (probeIndex == optics.sourceFrames.Length - 1)
+        {
+            bool changed = optics.probeSpecies == "Cat";
+            if (changed)
+                Require(bodyLocated && candidate.verified && idMatches && candidate.instance_id != probeIdentity &&
+                        metricActor && metricActor.reliableHeadPose && metricActor.headAnchor,
+                    "The previous head must be active when a fresh, different detector ID arrives.");
+            else Require(!candidate.verified, "Geometrically inconsistent face was accepted.");
+            ClearAutomaticHead();
+            if (changed)
+            {
+                var nextActor = UnityEngine.Object.FindObjectsByType<ParkActor>(FindObjectsInactive.Include, FindObjectsSortMode.None)
+                    .Single(a => a.instanceId == candidate.instance_id);
+                Require(!metricActor.reliableHeadPose && !metricActor.headAnchor &&
+                        !nextActor.reliableHeadPose && !nextActor.headAnchor,
+                    "Changing detector ID retained the old head or bypassed the new head's confirmation.");
+                trace.Add($"Cleared {probeIdentity} head on identity change to {candidate.instance_id}; new head was not confirmed.");
+            }
+        }
+        else if (candidate.verified && bodyLocated && idMatches && age <= receiver.maxAge)
+        {
+            var actor = UnityEngine.Object.FindObjectsByType<ParkActor>(FindObjectsInactive.Include, FindObjectsSortMode.None)
+                .Single(a => a.instanceId == candidate.instance_id);
+            Require(actor.species == optics.probeSpecies && !actor.virtualTarget, "Candidate bound to the wrong actor.");
+            if (probeIdentity != candidate.instance_id) ClearAutomaticHead();
+            probeIdentity = candidate.instance_id;
+            metricActor = actor;
+            probeLastAccepted = Time.realtimeSinceStartup;
+            if (++headContinuity >= 3 && actor.tracked)
+            {
+                if (!probeAnchor) probeAnchor = new GameObject("Automatic head research fixture").transform;
+                var k = optics.intrinsics;
+                var optical = new Vector3((candidate.x-k[2])*candidate.depth/k[0],(candidate.y-k[3])*candidate.depth/k[1],candidate.depth);
+                probeAnchor.position = StereoFusionGeometry.OpticalToHead(optical,new Pose(Vector3.zero,Quaternion.Euler(180,0,0)));
+                metricActor.headAnchor = probeAnchor;
+                metricActor.reliableHeadPose = true;
+                if (probeIndex < optics.probeDelayIndex) confirmedBeforeDelay++;
+                else confirmedAfterDelay++;
+                trace.Add(FormattableString.Invariant($"Applied {probeIdentity} head after {headContinuity} fresh frames at depth {candidate.depth:F3} m."));
+            }
+        }
+        else ClearAutomaticHead();
+        probeIndex++;
+        if (probeIndex == optics.sourceFrames.Length)
+        {
+            Require(errors == 0 && confirmedBeforeDelay > 0 && confirmedAfterDelay > 0 && !probeAnchor,
+                "Fresh automatic head failed to establish at least twice, or stale data survived.");
+            Finish(0,"PASS: saved BridgeStereoFusion verified frame-bound candidate Pet head, latency and expiry.");
+        }
+    }
+}
