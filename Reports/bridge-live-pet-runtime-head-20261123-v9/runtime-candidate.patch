@@ -0,0 +1,110 @@
+"""Opt-in head-only sidecar; ParkPet's PICF detector connection stays independent."""
+import argparse
+import math
+from pathlib import Path
+import socket
+import struct
+import sys
+import time
+
+import cv2
+import numpy as np
+
+from check_pet_head_ap10k import MODEL, head_pixels, read, sha
+from check_pet_head_body_window import two_eye_local
+from check_pet_head_camera_inputs import pxr_luminance
+
+
+def validate(header):
+    if (header['schema']!='pet-head-v1' or (header['width'],header['height'])!=(640,480) or
+        not isinstance(header['session'],str) or len(header['session'])!=32 or
+        not isinstance(header['instance_id'],str) or not 0<len(header['instance_id'])<=128 or
+        type(header['frame_id']) is not int or header['frame_id']<=0 or
+        type(header['timestamp']) is not int or header['timestamp']<=0):
+        raise ValueError('Invalid Pet stereo request identity')
+    x1,y1,x2,y2,d,f,b=(header[name] for name in ('x1','y1','x2','y2','disparity','focal','baseline'))
+    if not (all(math.isfinite(v) for v in (x1,y1,x2,y2,d,f,b)) and 0<=x1<x2<=640 and 0<=y1<y2<=480 and
+            min(x2-x1,y2-y1)>=12 and 2<=d<120 and f>0 and b>0 and .2<=f*b/d<=3.):
+        raise ValueError('Invalid Pet stereo calibration or box')
+    return np.array([x1,y1,x2,y2]),d,f*b
+
+
+def read_crop(client, header, eye, channels, recv_exact):
+    x,w,y,h=(header[k] for k in (f'{eye}_x',f'{eye}_w','top','crop_h'))
+    if (not all(type(v) is int for v in (x,w,y,h)) or not (w>=12 and h>=12 and
+            0<=x<x+w<=640 and 0<=y<y+h<=480)):
+        raise ValueError('Invalid Pet head crop dimensions')
+    count=struct.unpack('<I',recv_exact(client,4))[0]
+    if count!=w*h*channels:
+        raise ValueError('Incorrect Pet head crop data size')
+    crop=np.frombuffer(recv_exact(client,count),np.uint8).reshape(h,w,channels)
+    image=np.zeros((480,640,channels),dtype=np.uint8)
+    image[y:y+h,x:x+w]=crop
+    return image if channels>1 else image[:,:,0]
+
+
+def estimate(net, header, box, disparity, scale, rgba, gray_right):
+    left=cv2.cvtColor(rgba,cv2.COLOR_RGBA2BGR)
+    right=cv2.cvtColor(gray_right,cv2.COLOR_GRAY2BGR)
+    views=head_pixels(net,left,box),head_pixels(net,right,box-[disparity,0,disparity,0])
+    row=dict(disparityCeiling=120,bodyM=scale/disparity,scale=scale)
+    geometry,matches,pose_disparity=two_eye_local(row,*views,images=(pxr_luminance(left),gray_right))
+    record={key:header[key] for key in ('schema','session','frame_id','timestamp','instance_id')}
+    record.update(verified=geometry and ('nose' in matches or len(matches)>=2))
+    if record['verified']:
+        x,y=views[0]['nose']['xy']
+        d=round(x)-matches['nose'][0] if 'nose' in matches else pose_disparity
+        record.update(x=x,y=y,disparity=d)
+    return record
+
+
+def main(args):
+    sys.path.insert(0,str(args.detector_root.resolve()))
+    from pose_bridge import receive_json, recv_exact, send_json
+
+    cv2.setNumThreads(2)
+    weight=MODEL/'end2end.onnx'
+    assert sha(weight)==read(MODEL/'model-source.json')['onnxSha256']
+    net=cv2.dnn.readNetFromONNX(str(weight))
+    # Warm only the operator graph, without issuing or recording any estimator result.
+    net.setInput(np.zeros((1,3,256,256),dtype=np.float32))
+    net.forward(('simcc_x','simcc_y'))
+    with socket.socket() as server:
+        server.bind((args.host,args.port))
+        server.listen(1)
+        print(f'PET HEAD READY {args.port}',flush=True)
+        while True:
+            client,_=server.accept()
+            with client:
+                client.settimeout(2)
+                while True:
+                    header=None
+                    try:
+                        header=receive_json(client)
+                        started=time.perf_counter()
+                        box,disparity,scale=validate(header)
+                        left=read_crop(client,header,'left',4,recv_exact)
+                        right=read_crop(client,header,'right',1,recv_exact)
+                        reply=estimate(net,header,box,disparity,scale,left,right)
+                        if args.editor_check:
+                            print({**reply,'disparityUsed':disparity,'sidecarMs':round((time.perf_counter()-started)*1000,1)},flush=True)
+                        if args.delay_frame==reply['frame_id']:
+                            time.sleep(.33)
+                        send_json(client,reply)
+                    except (EOFError,OSError,ValueError,TypeError,KeyError) as error:
+                        if args.editor_check and header is not None:
+                            print(f'Head request {header.get("frame_id")} stopped: {error}',flush=True)
+                        break
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--detector-root',type=Path,required=True)
+    parser.add_argument('--host',default='127.0.0.1')
+    parser.add_argument('--port',type=int,default=15006)
+    parser.add_argument('--editor-check',action='store_true')
+    parser.add_argument('--delay-frame',type=int,default=0)
+    options=parser.parse_args()
+    if options.delay_frame and (not options.editor_check or options.host!='127.0.0.1'):
+        parser.error('Fault injection requires an isolated Editor replay')
+    main(options)
